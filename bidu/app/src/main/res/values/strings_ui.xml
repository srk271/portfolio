    <!-- Setup -->
    <string name="ui_setup_intro">Bidu runs in the background and listens for your wake word, so you rarely need to open this app. Give it the access below once. The statuses update when you come back to this screen.</string>
    <string name="ui_setup_allow">Allow</string>
    <string name="ui_setup_open_settings">Open settings</string>
    <string name="ui_status_granted">Granted</string>
    <string name="ui_status_missing">Missing</string>
    <string name="ui_status_optional_missing">Off (optional)</string>
    <string name="ui_status_unavailable">Not available</string>
    <string name="ui_setup_mic_title">Microphone</string>
    <string name="ui_setup_mic_desc">Needed to hear the wake word and your commands.</string>
    <string name="ui_setup_notifications_title">Notifications</string>
    <string name="ui_setup_notifications_desc">Shows that Bidu is listening, asks you to confirm actions and delivers reminders. Needed for background listening.</string>
    <string name="ui_setup_contacts_title">Contacts (optional)</string>
    <string name="ui_setup_contacts_desc">Lets Bidu find people when you say “mummy ko call kar”. Bidu only opens the dialer; it never places a call by itself.</string>
    <string name="ui_setup_overlay_title">Display over other apps</string>
    <string name="ui_setup_overlay_desc">Lets Bidu open apps for you while it runs in the background. Without it Bidu shows a “tap to open” notification instead. Android shows a list: find Bidu and turn it on.</string>
    <string name="ui_setup_alarms_title">Exact alarms</string>
    <string name="ui_setup_alarms_desc">Makes reminders ring on time. Without it they may be a few minutes late.</string>
    <string name="ui_setup_battery_title">Battery: unrestricted</string>
    <string name="ui_setup_battery_desc">Stops Android from putting Bidu to sleep, so it keeps listening day and night.</string>
    <string name="ui_setup_samsung_title">Samsung battery steps</string>
    <string name="ui_setup_samsung_steps">1. Settings → Apps → Bidu → Battery → Unrestricted.\n2. Settings → Battery → Background usage limits → Never sleeping apps → add Bidu.\n3. In Background usage limits, turn off “Put unused apps to sleep”.</string>
    <string name="ui_setup_open_app_battery">Open app battery settings</string>
    <string name="ui_setup_open_device_battery">Open device battery settings</string>
    <string name="ui_setup_model_title">Wake-word model</string>
    <string name="ui_setup_model_desc">Hands-free listening needs a one-time download of about %1$s from alphacephei.com. After that the wake word is detected offline, on this phone. Push-to-talk works without it.</string>
