    <string name="ui_model_consent_details">Source: %1$s\n\nThe file is downloaded once over your internet connection (mobile data counts). Nothing you say is uploaded for wake-word detection.</string>
    <string name="ui_model_consent_agree">Download</string>
    <string name="ui_privacy_title">Privacy</string>
    <string name="ui_privacy_text">The wake word is detected on this phone; that audio never leaves it. Commands are turned into text by Android speech recognition, which may use Google servers depending on your device settings. Cloud AI is off unless you turn it on in Settings.</string>
